<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_current_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Сегодня: "
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:textColor="@color/teal_200" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статистика заявок"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_total_repair"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Общее количество заявок на ремонт: 0"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_total_detailing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Общее количество заявок на детейлинг: 0"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_repair_in_work"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Заявки на ремонт в работе: 0"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_detailing_in_work"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Заявки на детейлинг в работе: 0"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_repair_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Заявки на ремонт выполнены: 0"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/white" />

        <TextView
            android:id="@+id/tv_detailing_completed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Заявки на детейлинг выполнены: 0"
            android:textSize="14sp"
            android:layout_marginBottom="24dp"
            android:textColor="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Все заявки на ремонт:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="@color/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_repair_orders"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:background="@color/purple_700" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Все заявки на детейлинг:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="@color/white" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_detailing_orders"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="24dp"
            android:background="@color/purple_700" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Назад"
            android:textSize="16sp"
            android:backgroundTint="@color/purple_500"
            android:textColor="@color/black" />

    </LinearLayout>
</ScrollView>